[
  {
    "id": "deploy-distro",
    "execute-command": "/opt/openmrscare/ops/onprem-webhook/deploy.sh",
    "command-working-directory": "/home/openmrsdev/openmrsdev/openmrs-distro-referenceapplication",
    "pass-arguments-to-command": [
      { "source": "payload", "name": "tag" }
    ],
    "trigger-rule": {
      "match": {
        "type": "payload-hmac-sha256",
        "secret": "REPLACE_WITH_YOUR_ONPREM_WEBHOOK_SECRET",
        "parameter": {
          "source": "header",
          "name": "X-Hub-Signature-256"
        }
      }
    }
  }
]
