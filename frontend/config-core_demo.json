  "@openmrs/esm-system-admin-app": {
    "extensionSlots": {
      "system-admin-page-card-link-slot": {
        "configure": {
          "system-administration-cohort-builder-card-link": {
            "Display conditions": {
              "expression": "session.user?.privileges.some(p => p.display === 'Get Patient Cohorts' || p.display === 'Add Cohorts' || p.display === 'Edit Cohorts')"
            }
          },
          "system-admin-page-link": {
            "Display conditions": {
              "expression": "session.user?.roles.some(r => r.display === 'System Developer' || r.display === 'Application: Has Super User Privileges') || !session.user?.privileges.some(p => p.display === 'App: stockmanagement.dashboard' || p.display === 'Task: stockmanagement.stockItems.dispense')"
            }
          },
          "reports-overview-admin-link": {
            "Display conditions": {
              "expression": "session.user?.roles.some(r => r.display === 'System Developer' || r.display === 'Application: Has Super User Privileges') || !session.user?.privileges.some(p => p.display === 'App: stockmanagement.dashboard' || p.display === 'Task: stockmanagement.stockItems.dispense')"
            }
          },
          "admin-service-queues-card-link": {
            "Display conditions": {
              "expression": "session.user?.roles.some(r => r.display === 'System Developer' || r.display === 'Application: Has Super User Privileges') || !session.user?.privileges.some(p => p.display === 'App: stockmanagement.dashboard' || p.display === 'Task: stockmanagement.stockItems.dispense')"
            }
          },
          "system-administration-form-builder-card-link": {
            "Display conditions": {
              "expression": "session.user?.roles.some(r => r.display === 'System Developer' || r.display === 'Application: Has Super User Privileges') || !session.user?.privileges.some(p => p.display === 'App: stockmanagement.dashboard' || p.display === 'Task: stockmanagement.stockItems.dispense')"
            }
          }
        }
      }
    }
  },
  "@openmrs/esm-patient-search-app": {
    "extensionSlots": {
      "start-visit-button-slot": {
        "configure": {
          "start-visit-button-patient-search": {
            "Display conditions": {
              "privileges": ["Add Visits"]
            }
          }
        }
      },
      "start-visit-button-slot2": {
        "configure": {
          "patient-search-start-visit-button": {
            "Display conditions": {
              "privileges": ["Add Visits"]
            }
          }
        }
      }
    }
  },
  "@openmrs/esm-primary-navigation-app": {
    "extensionSlots": {
      "top-nav-actions-slot": {
        "configure": {
          "add-patient-action": {
            "Display conditions": {
              "privileges": ["Add Patients"]
            }
          },
          "patient-search-icon": {
            "Display conditions": {
              "expression": "!session.user?.roles.some(r => r.display === 'Inventory Dispensing') && ['PHCC Clerk', 'Organizational: Registration Clerk', 'Organizational: Nurse', 'Organizational: Doctor', 'Organizational: System Administrator', 'PHCC Doctor', 'System Developer'].some(role => session.user?.roles.some(r => r.display === role))"
            }
          }
        }
      },
      "top-nav-app-menu-slot": {
        "configure": {
          "app-menu-button": {
            "Display conditions": {
              "expression": "session.user?.roles.some(r => r.display === 'System Developer') || session.user?.privileges.some(p => p.display === 'App: stockmanagement.dashboard' || p.display === 'Task: stockmanagement.stockItems.dispense')"
            }
          }
        }
      },
      "app-menu-slot": {
        "configure": {
          "dispensing-link": {
            "Display conditions": {
              "expression": "session.user?.roles.some(r => r.display === 'System Developer' || r.display === 'Application: Has Super User Privileges') || (!session.user?.privileges.some(p => p.display === 'App: stockmanagement.dashboard') && session.user?.privileges.some(p => p.display === 'Task: dispensing.create.dispense' || p.display === 'Task: dispensing.edit.dispense' || p.display === 'Task: dispensing.delete.dispense' || p.display === 'Task: stockmanagement.stockItems.dispense'))"
            }
          },
          "queue-screen-link": {
            "Display conditions": {
              "expression": "session.user?.roles.some(r => r.display === 'System Developer' || r.display === 'Application: Has Super User Privileges') || !session.user?.privileges.some(p => p.display === 'App: stockmanagement.dashboard' || p.display === 'Task: stockmanagement.stockItems.dispense')"
            }
          },
          "forms-app-link": {
            "Display conditions": {
              "expression": "session.user?.roles.some(r => r.display === 'System Developer' || r.display === 'Application: Has Super User Privileges') || !session.user?.privileges.some(p => p.display === 'App: stockmanagement.dashboard' || p.display === 'Task: stockmanagement.stockItems.dispense')"
            }
          },
          "system-administration-app-menu-link": {
            "Display conditions": {
              "expression": "session.user?.roles.some(r => r.display === 'Organizational: System Administrator') || session.user?.privileges.some(p => p.display === 'App: stockmanagement.dashboard')"
            }
          }
        }
      }
    }
  },
  "@openmrs/esm-help-menu-app": {
    "extensionSlots": {
      "help-menu-slot": {
        "remove": ["release-notes", "docs", "contact-us", "tutorials"]
      }
    }
  },
  "esm-labtestreport-app": {
    "extensionSlots": {
      "system-admin-page-card-link-slot": {
        "remove": [
          "lab-test-summary-admin-link",
          "patient-encounter-summary-admin-link",
          "disease-summary-admin-link",
          "session-attendance-admin-link",
          "stock-ledger-admin-link",
          "cmam-summary-admin-link",
          "bed-management-admin-card-link",
          "admin-ocl-card-link",
          "admin-report-link"
        ]
      }
    }
  },
  "@openmrs/esm-appointments-app": {
    "extensionSlots": {
      "homepage-dashboard-slot": {
        "remove": ["clinical-appointments-dashboard-link"]
      }
    }
  },
  "@openmrs/esm-service-queues-app": {
    "defaultInitialServiceQueue": "Front Desk",
    "pharmacyQueueName": "Pharmacy",
    "queueTables": {
      "columnDefinitions": [
        {
          "id": "actions",
          "columnType": "actions",
          "config": {
            "actions": {
              "buttons": ["move"],
              "overflowMenu": ["transition", "edit", "remove", "undo"]
            }
          }
        }
      ],
      "tableDefinitions": [
        {
          "columns": ["patient-name", "queue", "status", "location", "visit-duration", "programs", "actions"],
          "appliedTo": [{ "queue": "", "status": "" }]
        }
      ]
    },
    "Translation overrides": {
      "en": {
        "programs": "Service-type"
      }
    }
  },
  "@openmrs/esm-patient-registration-app": {
    "fieldConfigurations": {
      "name": {
        "allowUnidentifiedPatients": false
      },
      "gender": [{ "value": "male" }, { "value": "female" }],
      "address": {
        "useAddressHierarchy": {
          "enabled": false
        },
        "selectFields": [
          {
            "id": "stateProvince",
            "options": ["Gaza City", "Deir Al-Balah", "Khan Younis", "Rafah", "North Gaza"]
          }
        ],
        "fieldValidation": [{ "id": "address3", "validateLuhn": true }]
      },
      "phone": {
        "personAttributeUuid": "14d4f066-15f5-102d-96e4-000c29c2a5d7",
        "validation": {
          "required": false,
          "matches": "^[0-9]*$"
        }
      }
    },
    "Translation overrides": {
      "en": {
        "invalidInput": "Phone number should contain numbers only",
        "attributesLabelText": "Phone Number"
      }
    }
  },
  "@openmrs/esm-patient-chart-app": {
    "restrictByVisitLocationTag": true,
    "showUpcomingAppointments": false,
    "visitAttributeTypes": [
      {
        "uuid": "57ea0cbb-064f-4d09-8cf4-e8228700491c",
        "required": false,
        "displayInThePatientBanner": true
      }
    ],
    "extensionSlots": {
      "action-menu-patient-chart-items-slot": {
        "order": ["order-basket-action-menu"]
      },
      "patient-chart-dashboard-slot": {
        "remove": [
          "attachments-results-summary-dashboard",
          "growth-chart-dashboard-link",
          "procedures-summary-dashboard"
