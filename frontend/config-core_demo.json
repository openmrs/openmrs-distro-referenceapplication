{
  "@openmrs/esm-help-menu-app": {
    "extensionSlots": {
      "help-menu-slot": {
        "remove": ["release-notes", "docs", "contact-us", "tutorials"]
      }
    }
  },
  "@openmrs/esm-appointments-app": {
    "extensionSlots": {
      "homepage-dashboard-slot": {
        "remove": ["clinical-appointments-dashboard-link"]
      }
    }
  },
  "@openmrs/esm-service-queues-app": {
    "defaultInitialServiceQueue": "Front Desk",
    "pharmacyQueueName": "Pharmacy",
    "queueTables": {
      "columnDefinitions": [
        {
          "id": "actions",
          "columnType": "actions",
          "config": {
            "actions": {
              "buttons": ["move"],
              "overflowMenu": ["transition", "edit", "remove", "undo"]
            }
          }
        }
      ],
      "tableDefinitions": [
        {
          "columns": ["patient-name", "queue", "status", "location", "visit-duration", "programs", "actions"],
          "appliedTo": [{ "queue": "", "status": "" }]
        }
      ]
    },
    "Translation overrides": {
      "en": {
        "programs": "Service-type"
      }
    }
  },
  "@openmrs/esm-patient-registration-app": {
    "fieldConfigurations": {
      "name": {
        "allowUnidentifiedPatients": false
      },
      "gender": [{ "value": "male" }, { "value": "female" }],
      "address": {
        "useAddressHierarchy": {
          "enabled": false
        },
        "selectFields": [
          {
            "id": "stateProvince",
            "options": ["Gaza City", "Deir Al-Balah", "Khan Younis", "Rafah", "North Gaza"]
          }
        ],
        "fieldValidation": [{ "id": "address3", "validateLuhn": true }]
      },
      "phone": {
        "personAttributeUuid": "14d4f066-15f5-102d-96e4-000c29c2a5d7",
        "validation": {
          "required": false,
          "matches": "^[0-9]*$"
        }
      }
    },
    "Translation overrides": {
      "en": {
        "invalidInput": "Phone number should contain numbers only",
        "attributesLabelText": "Phone Number"
      }
    }
  },
  "@openmrs/esm-patient-chart-app": {
    "restrictByVisitLocationTag": true,
    "showUpcomingAppointments": false,
    "visitAttributeTypes": [
      {
        "uuid": "57ea0cbb-064f-4d09-8cf4-e8228700491c",
        "required": false,
        "displayInThePatientBanner": true
      }
    ],
    "extensionSlots": {
      "action-menu-patient-chart-items-slot": {
        "order": ["order-basket-action-menu"]
      },
      "patient-chart-dashboard-slot": {
        "remove": [
          "attachments-results-summary-dashboard",
          "growth-chart-dashboard-link",
          "patient-appointments-summary-dashboard",
          "procedures-summary-dashboard"
        ]
      }
    }
  },
  "@openmrs/esm-ward-app": {
    "extensionSlots": {
      "action-menu-ward-patient-items-slot": {
        "add": ["order-basket-action-menu"]
      },
      "homepage-dashboard-slot": {
        "remove": ["ward-dashboard-link", "clinical-appointments-dashboard-link"]
      }
    }
  },
  "@openmrs/esm-laboratory-app": {
    "labTableColumns": ["name", "patientId", "urgency", "age", "sex", "totalOrders", "action"]
  },
  "@openmrs/esm-styleguide": {
    "Brand color #1": "#005d5d",
    "Translation overrides": {
      "en": {
        "Conditions": "Diagnoses"
      }
    }
  },
  "@openmrs/esm-patient-conditions-app": {
    "Translation overrides": {
      "en": {
        "Conditions": "Diagnoses",
        "conditions": "diagnoses"
      }
    }
  },
  "@openmrs/esm-stock-management-app": {
    "packingUnitsUUID": "a6d438fe-05c1-4d4d-9755-c11cf6b0b3b9",
    "dispensingUnitsUUID": "162402AAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
    "stockAdjustmentReasonUUID": "3a9021d1-d6c1-4fc2-8e30-ca8e204e44de",
    "stockTakeReasonUUID": "faa466c5-0953-4d4f-8ea7-d9a06341c3f3",
    "stockSourceTypeUUID": "937a0440-95f7-42f6-aaef-16cf611fcf10",
    "stockItemCategoryUUID": "8ccf6066-9297-4d76-aaf3-00aa3714d198"
  },
  "@openmrs/esm-dispensing-app": {
    "enableStockDispense": true
  },
  "translations": {
    "ar": {
      "@openmrs/esm-bap-app": {
        "delete": "حذف",
        "preserve": "حفظ",
        "download": "تحميل"
      },
      "@openmrs/esm-reporting-app": {
        "delete": "حذف",
        "preserve": "حفظ",
        "download": "تحميل"
      }
    }
  }
}
