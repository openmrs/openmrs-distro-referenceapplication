{
  "@openmrs/esm-home-app": {
    "defaultDashboardPerRole": {
      "Organizational: Doctor": "act-home",
      "Organizational: Nurse": "act-home",
      "Organizational: Registration Clerk": "act-home",
      "Organizational: System Administrator": "act-home",
      "System Developer": "act-home"
    },
    "extensionSlots": {
      "homepage-dashboard-slot": {
        "order": [
          "act-home-dashboard-link",
          "act-registry-dashboard-link",
          "act-worklists-dashboard-link",
          "act-waiting-list-dashboard-link",
          "act-screen-positive-dashboard-link"
        ],
        "remove": [
          "clinical-appointments-dashboard-link",
          "service-queues-dashboard-link",
          "ward-dashboard-link",
          "billing-dashboard-link",
          "laboratory-dashboard-link",
          "patient-lists-dashboard-link"
        ]
      },
      "homepage-widgets-slot": {
        "remove": [
          "home-appointments"
        ]
      }
    }
  },
  "@openmrs/esm-patient-chart-app": {
    "restrictByVisitLocationTag": true,
    "showUpcomingAppointments": false,
    "extensionSlots": {
      "patient-chart": {
        "remove": [
          "patient-chart-order-basket"
        ]
      },
      "patient-chart-dashboard-slot": {
        "add": [
          "act-prophylaxis-dashboard-link",
          "act-cardiac-tests-dashboard-link"
        ],
        "remove": [
          "patient-orders-summary-dashboard",
          "test-results-summary-dashboard",
          "billing-summary-dashboard-link",
          "patient-appointments-summary-dashboard",
          "programs-summary-dashboard",
          "attachments-results-summary-dashboard",
          "immunization-summary-dashboard",
          "procedures-summary-dashboard",
          "conditions-summary-dashboard",
          "medications-summary-dashboard"
        ]
      },
      "patient-banner-tags-slot": {
        "remove": [
          "queue-patient-info-queue-entry-status",
          "patient-banner-billing-tags",
          "patient-banner-payment-status-tag"
        ]
      },
      "visit-form-top-slot": {
        "remove": [
          "patient-upcoming-appointment-widget"
        ]
      },
      "visit-form-bottom-slot": {
        "remove": [
          "visit-form-queue-fields"
        ]
      },
      "extra-visit-attribute-slot": {
        "remove": [
          "billing-checkin-form"
        ]
      },
      "visit-summary-panels": {
        "remove": [
          "visit-bills-panel"
        ]
      },
      "patient-actions-slot": {
        "remove": [
          "add-patient-to-patient-list-button"
        ]
      }
    }
  },
  "@openmrs/esm-ward-app": {
    "extensionSlots": {
      "action-menu-ward-patient-items-slot": {
        "add": [
          "order-basket-action-menu"
        ]
      }
    }
  },
  "@openmrs/esm-laboratory-app": {
    "labTableColumns": [
      "name",
      "patientId",
      "urgency",
      "age",
      "sex",
      "totalOrders",
      "action"
    ]
  },
  "@openmrs/esm-styleguide": {
    "Brand color #1": "#005d5d"
  },
