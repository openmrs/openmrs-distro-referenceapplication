{
  "@openmrs/esm-home-app": {
    "extensionSlots": {
      "homepage-dashboard-slot": {
        "configure": {
          "laboratory-dashboard-link": {
            "Display conditions": {
              "expression": "session.user?.roles.some(r => r.display === 'PHCC Lab Technician' || r.display === 'System Developer' || r.display === 'Application: Has Super User Privileges')"
            }
          },
          "patient-lists-dashboard-link": {
            "Display conditions": {
              "expression": "session.user?.roles.some(r => r.display === 'System Developer' || r.display === 'Application: Has Super User Privileges') || !(session.user?.roles.some(r => r.display === 'PHCC Lab Technician') || session.user?.privileges.some(p => p.display === 'App: stockmanagement.dashboard' || p.display === 'Task: stockmanagement.stockItems.dispense'))"
            }
          }
        }
      }
    }
  },
  "@openmrs/esm-patient-forms-app": {
    "locationFormsAllowlist": [
      {
