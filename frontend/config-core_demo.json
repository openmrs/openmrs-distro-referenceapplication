{
  "@openmrs/esm-patient-registration-app": {
    "fieldConfigurations": {
      "name": {
        "allowUnidentifiedPatients": false
      },
      "gender": [{ "value": "male" }, { "value": "female" }],
      "address": {
        "useAddressHierarchy": {
          "enabled": false
        },
        "selectFields": [
          {
            "id": "stateProvince",
            "options": ["Gaza City", "Deir Al-Balah", "Khan Younis", "Rafah", "North Gaza"]
          }
        ],
        "fieldValidation": [{ "id": "address3", "validateLuhn": true }]
      }
    }
  },
  "@openmrs/esm-patient-chart-app": {
    "restrictByVisitLocationTag": true,
    "showUpcomingAppointments": false,
    "visitAttributeTypes": [
      {
        "uuid": "57ea0cbb-064f-4d09-8cf4-e8228700491c",
        "required": false,
        "displayInThePatientBanner": true
      }
    ],
    "extensionSlots": {
      "action-menu-patient-chart-items-slot": {
        "order": ["order-basket-action-menu"]
      },
      "patient-chart-dashboard-slot": {
        "remove": [
          "attachments-results-summary-dashboard",
          "growth-chart-dashboard-link",
          "patient-appointments-summary-dashboard",
          "procedures-summary-dashboard"
        ]
      }
    }
  },
  "@openmrs/esm-ward-app": {
    "extensionSlots": {
      "action-menu-ward-patient-items-slot": {
        "add": ["order-basket-action-menu"]
      },
      "homepage-dashboard-slot": {
        "remove": ["ward-dashboard-link", "clinical-appointments-dashboard-link"]
      }
    }
  },
  "@openmrs/esm-laboratory-app": {
    "labTableColumns": ["name", "patientId", "urgency", "age", "sex", "totalOrders", "action"]
  },
  "@openmrs/esm-styleguide": {
    "Brand color #1": "#005d5d",
    "Translation overrides": {
      "en": {
        "Conditions": "Diagnoses"
      }
    }
  },
  "@openmrs/esm-patient-conditions-app": {
    "Translation overrides": {
      "en": {
        "Conditions": "Diagnoses",
        "conditions": "diagnoses"
      }
    }
  },
  "translations": {
    "ar": {
      "@openmrs/esm-bap-app": {
        "delete": "حذف",
        "preserve": "حفظ",
        "download": "تحميل"
      },
      "@openmrs/esm-reporting-app": {
        "delete": "حذف",
        "preserve": "حفظ",
        "download": "تحميل"
      }
    }
  }
}
