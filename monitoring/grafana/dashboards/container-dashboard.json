{
  "title": "Container Resources",
  "uid": "openmrs-backend",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "tags": ["container"],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU Usage",
      "description": "CPU consumed by the backend container, as a percentage of a single core (100% = one full core; can exceed 100% on multi-core hosts). Watch for sustained highs or a rising baseline. If it sits near the host's core limit during normal use, allocate more CPU or scale out; brief spikes during startup or batch jobs are usually fine. Correlate spikes with slow requests or high load.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name=\"backend\",cpu=\"total\"}[5m])) * 100",
          "legendFormat": "CPU %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "lineWidth": 1, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "single", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Memory",
      "description": "Backend container memory over time. Working Set = active memory that cannot be reclaimed under pressure (this is what counts toward OOM limits); RSS = anonymous (non-file-backed) memory; Cache = reclaimable page cache. A steadily climbing Working Set that never drops back may indicate a memory leak — investigate or schedule restarts and consider raising the memory limit. Working Set approaching the container limit risks an OOM kill (see the OOM Events panel).",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum by (name) (container_memory_working_set_bytes{name=\"backend\"})",
          "legendFormat": "Working Set"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum by (name) (container_memory_rss{name=\"backend\"})",
          "legendFormat": "RSS"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum by (name) (container_memory_cache{name=\"backend\"})",
          "legendFormat": "Cache"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": { "lineWidth": 1, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Network I/O",
      "description": "Rate of network traffic in/out of the backend container (bytes/sec). Receive is inbound traffic (client requests, DB responses); Transmit is outbound (responses, DB queries). Use this to understand traffic patterns and spot anomalies — an unexpected sustained spike may signal a traffic surge, a runaway client, or bulk data transfer. Flat-zero when the service should be busy can indicate a connectivity or upstream problem.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum by (name) (rate(container_network_receive_bytes_total{name=\"backend\"}[5m]))",
          "legendFormat": "⬇ Receive"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum by (name) (rate(container_network_transmit_bytes_total{name=\"backend\"}[5m]))",
          "legendFormat": "⬆ Transmit"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0,
          "custom": { "lineWidth": 1, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Disk I/O",
      "description": "Rate of bytes read from / written to disk by the backend container (bytes/sec). Decisions: sustained high I/O can bottleneck request latency — correlate with CPU and slow responses. Heavy writes may come from logging or file storage; heavy reads may indicate cache misses or large file access. Persistent saturation suggests moving to faster storage or reducing disk-bound work.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum by (name) (rate(container_fs_reads_bytes_total{name=\"backend\"}[5m]))",
          "legendFormat": "Read"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum by (name) (rate(container_fs_writes_bytes_total{name=\"backend\"}[5m]))",
          "legendFormat": "Write"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0,
          "custom": { "lineWidth": 1, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Uptime",
      "description": "Time since the backend container last started. Red for the first minute, yellow up to 5 minutes, green after — reflecting that the app needs time to fully boot. An unexpectedly low value means the container recently restarted or crashed — check the OOM Events panel and container logs to find why. A frequently-resetting uptime signals a crash loop.",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "time() - max by (name) (container_start_time_seconds{name=\"backend\"})",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dtdhms",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "green", "value": 300 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Memory (Working Set)",
      "description": "Current active (non-reclaimable) memory used by the backend — the value that counts against the container's memory limit. Green below 1 GB, yellow above 1 GB, red above 2 GB. If it stays red near the container limit, raise the limit or investigate a leak (see the Memory timeseries for the trend). Values close to the limit make an OOM kill likely.",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum by (name) (container_memory_working_set_bytes{name=\"backend\"})",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1073741824 },
              { "color": "red", "value": 2147483648 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "OOM Events (24 h)",
      "description": "Count of out-of-memory kills in the last 24 hours. Green at 0, red at 1 or more. Any value > 0 means the kernel killed the container for exceeding its memory limit. If > 0, raise the container memory limit and/or investigate a memory leak (see the Memory panels), and check Uptime for the resulting restart. Recurring OOM kills point to an under-provisioned limit or a genuine leak that needs a code fix.",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum by (name) (increase(container_oom_events_total{name=\"backend\"}[24h]))",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    }
  ]
}
