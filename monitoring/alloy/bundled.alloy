//
// OpenMRS OTLP metrics -> Prometheus
//

otelcol.processor.batch "openmrs" {
  output {
    metrics = [
      otelcol.exporter.prometheus.openmrs.input,
    ]
  }
}

otelcol.exporter.prometheus "openmrs" {
  forward_to = [
    prometheus.remote_write.local.receiver,
  ]
}


//
// cAdvisor -> Prometheus directly
//

prometheus.scrape "cadvisor" {
  targets = [
    {
      __address__ = "cadvisor:8080",
    },
  ]

  job_name        = "cadvisor"
  scrape_interval = "15s"

  forward_to = [
    prometheus.relabel.cadvisor.receiver,
  ]
}

prometheus.relabel "cadvisor" {
  //
  // Keep only the container metrics we care about.
  //
  rule {
    action        = "keep"
    source_labels = ["__name__"]
    regex         = "up|machine_(cpu_cores|memory_bytes)|container_(cpu_usage_seconds_total|cpu_cfs_throttled_seconds_total|memory_working_set_bytes|memory_usage_bytes|memory_rss|memory_cache|spec_memory_limit_bytes|spec_cpu_quota|spec_cpu_period|network_(receive|transmit)_(bytes|errors)_total|fs_(reads|writes)_bytes_total|fs_usage_bytes|fs_limit_bytes|oom_events_total|start_time_seconds|last_seen)"
  }

  //
  // Match the service_name label used by Loki.
  //
  rule {
    action        = "replace"
    source_labels = ["container_label_com_docker_compose_service"]
    regex         = "(.+)"
    target_label  = "service_name"
  }

  //
  // Drop any other Docker labels.
  //
  rule {
    action = "labeldrop"
    regex  = "container_label_.*"
  }

  forward_to = [
    prometheus.remote_write.local.receiver,
  ]
}


//
// Shared Prometheus destination
//

prometheus.remote_write "local" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}
