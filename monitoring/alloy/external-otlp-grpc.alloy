otelcol.processor.batch "external" {
  output {
    metrics = [
      otelcol.exporter.otlp.external.input,
    ]
  }
}

otelcol.exporter.otlp "external" {
  client {
    endpoint = sys.env("ALLOY_OTLP_ENDPOINT")
    headers = encoding.from_json(coalesce(sys.env("ALLOY_OTLP_HEADERS"), "{}"))

    tls {
      insecure = sys.env("ALLOY_OTLP_INSECURE") == "true"
    }
  }
}
