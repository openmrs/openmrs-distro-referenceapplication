	<!-- Configure the CMAM Follow-up Service -->
	<bean parent="serviceContext">
		<property name="moduleService">
			<list>
				<value>org.openmrs.module.labtestreport.CmamFollowUpService</value>
				<ref bean="cmamFollowUpService"/>
			</list>
		</property>
