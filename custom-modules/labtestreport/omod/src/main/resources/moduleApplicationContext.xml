	<bean id="stockLedgerService" class="org.springframework.transaction.interceptor.TransactionProxyFactoryBean">
		<property name="transactionManager"><ref bean="transactionManager"/></property>
		<property name="target">
			<bean class="org.openmrs.module.labtestreport.impl.StockLedgerServiceImpl">
				<property name="dao">
					<bean class="org.openmrs.module.labtestreport.db.hibernate.HibernateStockLedgerDAO">
